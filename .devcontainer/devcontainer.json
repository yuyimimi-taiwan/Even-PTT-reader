{
  "name": "Even PTT Reader Simulator",
  "build": { "dockerfile": "Dockerfile" },
  "forwardPorts": [5173, 9898],
  "portsAttributes": {
    "5173": { "label": "PTT Reader phone webview", "onAutoForward": "notify" },
    "9898": { "label": "Even simulator control and screenshots", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash -lc 'npm install && sudo npm install -g @evenrealities/evenhub-cli @evenrealities/evenhub-simulator'",
  "postStartCommand": "bash -lc 'nohup npm run dev -- --host 0.0.0.0 >/tmp/even-ptt-vite.log 2>&1 & sleep 5; nohup npm run sim:headless >/tmp/even-ptt-simulator.log 2>&1 &'",
  "customizations": {
    "vscode": {
      "settings": { "terminal.integrated.defaultProfile.linux": "bash" }
    }
  }
}
